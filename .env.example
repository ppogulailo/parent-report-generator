OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
API_SECRET_KEY=
ALLOWED_ORIGIN=
PORT=3000

# ── Saved plans (Milestone 5) ────────────────────────────────────────────────
# Postgres for saved plans. UNSET is a supported state: plans are generated but
# not saved, and no return link is offered.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mi_dev?schema=public

# 32-byte key, base64-encoded, encrypting the urgent note at rest.
# Generate with: openssl rand -base64 32   — CANNOT be rotated casually.
FIELD_ENCRYPTION_KEY=

# PDF rendering (Chromium). 'false' hides the download; print remains.
PDF_ENABLED=true
CHROMIUM_PATH=
